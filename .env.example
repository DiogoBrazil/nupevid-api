DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
# If the password contains @, :, / or similar, URL-encode it in the URLs below.
DATABASE_URL=postgresql://user:password@localhost:5432/database
DOCKER_DATABASE_URL=postgresql://user:password@postgres:5432/database
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/database_test
SERVER_ADDR=0.0.0.0:8080
JWT_SECRET=change_this_jwt_secret_with_at_least_32_bytes
JWT_ISSUER=nupevid-api
JWT_AUDIENCE=nupevid-api
# Access token (JWT) lifetime in seconds. Default: 900 (15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in seconds. Default: 604800 (7 days).
REFRESH_TOKEN_TTL_SECONDS=604800
API_KEY=change_this_api_key_with_at_least_32_bytes
# Max requests per minute per client IP on /auth/login, /auth/refresh and
# /auth/logout (brute-force protection). 0 disables rate limiting. Default: 5.
LOGIN_RATE_LIMIT_PER_MINUTE=5
DB_MAX_CONNECTIONS=20
ENABLE_BOOTSTRAP_ROOT=false
# Apply pending DB migrations automatically on startup. Default: true.
RUN_MIGRATIONS_ON_STARTUP=true
JSON_PAYLOAD_LIMIT_BYTES=1048576
CLIENT_REQUEST_TIMEOUT_SECONDS=15
KEEP_ALIVE_SECONDS=75
LGPD_RETENTION_POLICY_DAYS=
AUDIT_LOG_RETENTION_DAYS=
RETENTION_ENFORCEMENT_ENABLED=false
RUST_LOG=info

# LogDock (log viewer UI)
LOGDOCK_ADMIN=admin
LOGDOCK_PASSWORD=change-this-in-production
LOGDOCK_JWT_SECRET=generate_a_64_hex_secret_for_production
LOGDOCK_BASE_PATH=/logdock

# Traefik
TRAEFIK_LOG_LEVEL=INFO
